# Copy to .env and adjust. Every variable is optional; defaults are shown.

# --- LLM -------------------------------------------------------------------------------
# anthropic  -> Claude writes the answer (requires ANTHROPIC_API_KEY)
# extractive -> no LLM: returns the most relevant sentence(s) verbatim (no key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2048
# Server-side refusal fallback (beta server-side-fallback-2026-07-01)
ANTHROPIC_FALLBACKS=true
LLM_TIMEOUT_SECONDS=60

# --- Ingestion -------------------------------------------------------------------------
# A .md/.txt file, or a directory of them. The index is rebuilt automatically when it changes.
DOCUMENT_PATH=data/policies.md
INDEX_DIR=.index
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Embeddings ------------------------------------------------------------------------
# fastembed (local ONNX model, default) | hashing (lexical, offline tests only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed

# --- Retrieval & guardrails ------------------------------------------------------------
TOP_K=4
# Calibrated for bge-small-en-v1.5 with scripts/evaluate.py. Re-calibrate if you change the model.
SIMILARITY_THRESHOLD=0.65
MAX_CONTEXT_TOKENS=1500
BLOCK_PROMPT_INJECTION=true

LOG_LEVEL=INFO
